{
  "fuzzing": {
    "workers": 4,
    "testLimit": 50000,
    "shrinkLimit": 5000,
    "callSequenceLength": 64,
    "coverageEnabled": true,
    "corpusDirectory": "phase6-corpus/cand001",
    "coverageFormats": [
      "lcov"
    ],
    "revertReporterEnabled": true,
    "targetContracts": [
      "P4Cand001HarnessV1"
    ],
    "senderAddresses": [
      "0x10000",
      "0x20000",
      "0x30000",
      "0x40000"
    ],
    "blockNumberDelayMax": 64,
    "blockTimestampDelayMax": 86400,
    "testing": {
      "stopOnFailedTest": false,
      "stopOnNoTests": true,
      "testAllContracts": false,
      "testViewMethods": true,
      "assertionTesting": {
        "enabled": true
      },
      "propertyTesting": {
        "enabled": true,
        "testPrefixes": [
          "property_",
          "invariant_",
          "echidna_"
        ]
      },
      "optimizationTesting": {
        "enabled": false,
        "testPrefixes": [
          "optimize_"
        ]
      },
      "targetFunctionSignatures": [
        "P4Cand001HarnessV1.action_publicKeeperFallback(uint256)"
      ],
      "excludeFunctionSignatures": []
    },
    "chainConfig": {
      "cheatCodes": {
        "cheatCodesEnabled": true,
        "enableFFI": false
      },
      "forkConfig": {
        "forkModeEnabled": true,
        "rpcUrl": "PHASE6_RUNTIME_INJECTION_REQUIRED",
        "rpcBlock": 1,
        "poolSize": 10
      }
    }
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": ".",
      "args": [
        "--foundry-compile-all"
      ]
    }
  },
  "slither": {
    "useSlither": true
  },
  "logging": {
    "level": "info",
    "logDirectory": "",
    "noColor": true
  }
}
