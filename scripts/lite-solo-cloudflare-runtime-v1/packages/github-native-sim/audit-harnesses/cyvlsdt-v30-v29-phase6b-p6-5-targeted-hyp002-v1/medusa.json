{
  "fuzzing": {
    "workers": 10,
    "testLimit": 80000,
    "shrinkLimit": 10000,
    "callSequenceLength": 128,
    "coverageEnabled": true,
    "corpusDirectory": "phase6-corpus/cyvlsdt-v30-v29-p6-5-targeted-hyp002-v1",
    "coverageFormats": [
      "lcov",
      "html"
    ],
    "revertReporterEnabled": true,
    "targetContracts": [
      "CyvlSdtVaultPhase6HarnessV3"
    ],
    "senderAddresses": [
      "0x10000",
      "0x20000",
      "0x30000",
      "0x40000",
      "0x50000",
      "0x60000"
    ],
    "blockNumberDelayMax": 64,
    "blockTimestampDelayMax": 86400,
    "testing": {
      "stopOnFailedTest": false,
      "stopOnNoTests": true,
      "testAllContracts": false,
      "testViewMethods": true,
      "assertionTesting": {
        "enabled": false
      },
      "propertyTesting": {
        "enabled": true,
        "testPrefixes": [
          "property_",
          "invariant_"
        ]
      },
      "optimizationTesting": {
        "enabled": false,
        "testPrefixes": [
          "optimize_"
        ]
      },
      "targetFunctionSignatures": [
        "CyvlSdtVaultPhase6HarnessV3.probeP2MutableEstimate(uint96)",
        "CyvlSdtVaultPhase6HarnessV3.actionSetEstimate(uint96)",
        "CyvlSdtVaultPhase6HarnessV3.actionDeposit(uint96)",
        "CyvlSdtVaultPhase6HarnessV3.actionWithdrawAll()",
        "CyvlSdtVaultPhase6HarnessV3.actionDonateStrategy(uint96)",
        "CyvlSdtVaultPhase6HarnessV3.actionBoundaryEstimate(uint8)",
        "CyvlSdtVaultPhase6HarnessV3.actionBoundaryDeposit(uint8)",
        "CyvlSdtVaultPhase6HarnessV3.actionBoundaryWithdraw(uint8)",
        "CyvlSdtVaultPhase6HarnessV3.actionTransferShares(address,uint96)",
        "CyvlSdtVaultPhase6HarnessV3.actionBoundaryTransfer(address,uint8)"
      ],
      "excludeFunctionSignatures": []
    },
    "chainConfig": {
      "cheatCodes": {
        "cheatCodesEnabled": true,
        "enableFFI": false
      },
      "forkConfig": {
        "forkModeEnabled": true,
        "rpcUrl": "PHASE6_RUNTIME_INJECTION_REQUIRED",
        "rpcBlock": 1,
        "poolSize": 20
      }
    }
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": ".",
      "args": [
        "--foundry-compile-all"
      ]
    }
  },
  "slither": {
    "useSlither": true
  },
  "logging": {
    "level": "info",
    "logDirectory": "",
    "noColor": true
  }
}
